# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard -> Project Settings -> API).

# Safe to expose in the app bundle -- protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER exposed to the app. Used only by scripts run on your own machine
# (e.g. scripts/seed-content.ts) that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
